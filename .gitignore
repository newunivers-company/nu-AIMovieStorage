# 의존성·빌드 산출물 — 설치하면 다시 생깁니다
node_modules/
dist/
src-tauri/target/
src-tauri/gen/schemas/

# 열쇠는 절대 올리지 않습니다. 한 번 들어가면 기록에서 지워지지 않습니다.
.env
.env.*
!.env.example

# 편집기·운영체제가 흘리는 것들
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# 예전에 쓰던 도구가 남기던 폴더들
.manus-logs/
client/public/__manus__/

# 작업 기록 원문 (24MB). 저장소를 다섯 배로 불립니다 —
# git 이력에 한번 들어가면 지워도 용량이 안 줍니다. 로컬에만 둡니다.
docs/복원/기록/

# 에이전트 작업 트리. 합치고 나면 지워집니다 — 저장소에 넣지 않습니다.
.claude/worktrees/

# 파이썬 바이트코드. 업스케일 워커 스크립트를 여기서 한 번 돌려 보면 리소스 폴더에 생기는데,
# 번들에는 안 실리고(tauri.conf.json 이 *.py·*.json·requirements.txt 만 집음) 저장소만 더럽힙니다.
# 소스를 고친 뒤 stale 한 .pyc 가 남으면 «고쳤는데 안 바뀐다» 를 만듭니다.
__pycache__/
*.pyc

# 시험대가 흘리는 것들 — 결과 JSON·헤드리스 크롬 프로필. 다시 돌리면 또 생깁니다.
scratch/

# i18n 열쇠 대조 결과. 스크립트를 돌리면 또 생기는 보고서라 저장소에 넣지 않습니다.
keys-report.json

# 업데이터 서명 열쇠. 개인 열쇠가 저장소에 들어가면 누구나 가짜 업데이트를 서명할 수 있습니다.
# 진짜 자리는 앱 설정 폴더(API 키와 같은 곳)이고, CI 는 저장소 비밀값으로 받습니다.
*.key
*.key.pub
